includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    scanFiles:
        - vendor/amaia/basics13/tests/TestCase.php
        - vendor/amaia/basics13/tests/TranslationFilesTestCase.php
        - vendor/amaia/basics13/tests/BootstrapTestCase.php
        - vendor/amaia/basics13/tests/PackageIsolationTestCase.php

    paths:
        - config/
        - database/
        - resources/
        - src/
        - tests/

    level: 7
